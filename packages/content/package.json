{
  "name": "@alrisali/content",
  "version": "0.0.0",
  "private": true,
  "description": "Bundled Quran, book and time-zone data, with a NOTICE per source.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./books": "./src/books/index.ts",
    "./books/fonts/amiri.ttf": "./src/books/fonts/amiri-regular.ttf",
    "./books/fonts/ibm-plex-sans-arabic.ttf": "./src/books/fonts/ibm-plex-sans-arabic-regular.ttf",
    "./quran": "./src/quran/index.ts",
    "./quran/font.ttf": "./src/quran/data/kfgqpc_hafs_v30.ttf",
    "./magnetic-model": "./src/magnetic-model/index.ts",
    "./qibla-targets": "./src/qibla-targets/index.ts",
    "./time-zones": "./src/time-zones/index.ts"
  },
  "scripts": {
    "check-types": "tsc -b",
    "books:build": "bun scripts/books/build-books.ts",
    "quran:build": "bun scripts/quran/build.ts",
    "quran:build-hizb": "bun scripts/quran/build-hizb.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0"
  },
  "devDependencies": {
    "@alrisali/config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
