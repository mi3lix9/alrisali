{
  "name": "alrisali",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29",
      "@orpc/contract": "^1.15.6",
      "@orpc/server": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.7",
      "@tanstack/react-query": "^5.104.2",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/tanstack-query": "^1.15.6",
      "@orpc/client": "^1.15.6",
      "@tanstack/react-form": "^1.33.5",
      "@better-auth/expo": "1.7.7",
      "drizzle-orm": "1.0.0-rc.4",
      "i18next": "^26.4.5",
      "react-i18next": "^17.0.16",
      "temporal-polyfill": "^1.0.6",
      "vitest": "^5.0.4",
      "zustand": "^5.0.15",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "lucide-react": "^1.56.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @alrisali/db-server --",
    "db:studio": "turbo run db:studio -F @alrisali/db-server --",
    "db:generate": "turbo run db:generate -F @alrisali/db-server --",
    "db:migrate": "turbo run db:migrate -F @alrisali/db-server --",
    "db:local": "turbo run db:local -F @alrisali/db-server --",
    "db:sync-server": "bun run --filter @alrisali/db-user sync-server",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db-server/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db-server/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "uncheck && bun run check:boundaries",
    "check:boundaries": "bunx --bun depcruise --config .dependency-cruiser.cjs apps packages",
    "check:fix": "uncheck --fix",
    "test": "vitest run --passWithNoTests",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@alrisali/config": "workspace:*",
    "@types/bun": "catalog:",
    "dependency-cruiser": "^18.6.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sherif": "^1.13.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.1",
    "uncheck": "^0.1.1",
    "varlock": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@tursodatabase/sync-react-native@0.8.3": "patches/@tursodatabase%2Fsync-react-native@0.8.3.patch",
    "panelui-native@0.111.0": "patches/panelui-native@0.111.0.patch",
    "expo-widgets@58.0.19": "patches/expo-widgets@58.0.19.patch"
  }
}
