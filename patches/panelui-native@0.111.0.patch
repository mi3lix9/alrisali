diff --git a/node_modules/panelui-native/src/providers/labels.tsx b/src/providers/labels.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..31ed8df6bb527c44cf257e81a3f9b68427286fdc
--- /dev/null
+++ b/src/providers/labels.tsx
@@ -0,0 +1,65 @@
+import { createContext, useContext, useMemo, type ReactNode } from 'react';
+
+/**
+ * The words Panel UI's controls speak to assistive technology. English by
+ * default; an app in another language passes its own through
+ * `PanelUIProvider`'s `labels`.
+ */
+export interface PanelUILabels {
+  /** A sheet's backdrop, which closes it. */
+  closeSheet: string;
+  /** A sheet's close button. */
+  close: string;
+  /** A toast's close button. */
+  dismissNotification: string;
+  /** A NumberInput's minus button, given the field's label when it has one. */
+  decrease: (label: string | undefined) => string;
+  /** A NumberInput's plus button, given the field's label when it has one. */
+  increase: (label: string | undefined) => string;
+  /** The calendar's month arrows. */
+  previousMonth: string;
+  nextMonth: string;
+  /** The calendar caption's month and year pickers. */
+  month: string;
+  year: string;
+  /** The time picker's wheels and faces. */
+  hour: string;
+  minute: string;
+  amPm: string;
+  time: string;
+  /** How far along a Progress bar is, 0–1, as its spoken value: "25%". */
+  percent: (fraction: number) => string;
+}
+
+export const DEFAULT_LABELS: PanelUILabels = {
+  closeSheet: 'Close sheet',
+  close: 'Close',
+  dismissNotification: 'Dismiss notification',
+  decrease: (label) => `Decrease ${label ?? 'value'}`,
+  increase: (label) => `Increase ${label ?? 'value'}`,
+  previousMonth: 'Previous month',
+  nextMonth: 'Next month',
+  month: 'Month',
+  year: 'Year',
+  hour: 'Hour',
+  minute: 'Minute',
+  amPm: 'AM or PM',
+  time: 'Time',
+  percent: (fraction) => `${Math.round(fraction * 100)}%`,
+};
+
+const LabelsContext = createContext<PanelUILabels>(DEFAULT_LABELS);
+
+/** The labels in effect: the app's, over the English defaults. */
+export const useLabels = (): PanelUILabels => useContext(LabelsContext);
+
+export function LabelsProvider({
+  labels,
+  children,
+}: {
+  labels?: Partial<PanelUILabels>;
+  children: ReactNode;
+}) {
+  const value = useMemo(() => ({ ...DEFAULT_LABELS, ...labels }), [labels]);
+  return <LabelsContext.Provider value={value}>{children}</LabelsContext.Provider>;
+}
