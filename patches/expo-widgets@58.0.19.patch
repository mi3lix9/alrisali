+/**
+ * A widget Button whose target is `open:<url>` opens that URL in the app on a tap:
+ * a deep link, started from the tap itself (a broadcast receiver may not start
+ * an activity from the background).
+ */
+internal const val WIDGET_OPEN_TARGET_PREFIX = "open:"
+
 internal fun WidgetInteraction.toGlanceAction(context: Context): Action {
+  if (source is InteractionSource.Widget && target.startsWith(WIDGET_OPEN_TARGET_PREFIX)) {
+    return actionStartActivity(
+      Intent(Intent.ACTION_VIEW, Uri.parse(target.removePrefix(WIDGET_OPEN_TARGET_PREFIX)))
+        .setPackage(context.packageName)
+    )
+  }
   val intent = when (source) {
     is InteractionSource.Widget -> Intent(WIDGET_INTERACTION_ACTION)
       .setComponent(widgetProviderComponentName(context, source.name))
