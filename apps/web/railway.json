{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bunx turbo run build --filter=web",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "package.json",
      "bun.lock",
      "turbo.json",
      "patches/**"
    ]
  },
  "deploy": {
    "startCommand": "bun --bun run --cwd apps/web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
