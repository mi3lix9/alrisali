# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# App Store listing the landing page links to. The default is a placeholder until the App Store listing exists.
# @public @type=url
VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000

# Google Play listing the landing page links to.
# @public @type=url
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.alrisali.app

# Sentry DSN for web errors (browser and SSR). Unset: Sentry stays off.
# @public @optional @type=url
VITE_SENTRY_DSN=

# Apple Developer Team ID (developer.apple.com > Membership). Served in
# /.well-known/apple-app-site-association so iOS opens the app's links; unset,
# that file answers 404 and universal links stay off.
# @optional @sensitive=false @type=string(minLength=1)
APPLE_TEAM_ID=

# SHA-256 fingerprints of the Android signing certificates (Play Console > App
# signing: the app signing key and, if used, the upload key), comma-separated,
# `AA:BB:…`. Served in /.well-known/assetlinks.json; unset, that file answers
# 404 and Android does not verify the app's links.
# @optional @sensitive=false
ANDROID_CERT_SHA256=
