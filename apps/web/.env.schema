# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# App Store listing the landing page links to. The default is a placeholder until the App Store listing exists.
# @public @type=url
VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000

# Google Play listing the landing page links to.
# @public @type=url
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.alrisali.app

# Sentry DSN for web errors (browser and SSR). Unset: Sentry stays off.
# @public @optional @type=url
VITE_SENTRY_DSN=
