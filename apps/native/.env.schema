# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# Sentry DSN for app crashes and errors. Unset: Sentry stays off.
# @public @optional @type=url
EXPO_PUBLIC_SENTRY_DSN=

# Build time only (EAS / local release builds): Sentry org and project slugs
# for uploading source maps and debug symbols. Never bundled.
# @optional
SENTRY_ORG=

# @optional
SENTRY_PROJECT=

# Build time only. Without it, source map and debug symbol upload is skipped.
# @optional
SENTRY_AUTH_TOKEN=
