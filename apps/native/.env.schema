# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# Google OAuth web client ID (Google Cloud Console > Credentials). The app
# passes it as `webClientId`, so the native Google sheet returns an ID token
# the server accepts (it must be in the server's GOOGLE_CLIENT_IDS).
# @public @type=string(minLength=1)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth iOS client ID. app.config.ts derives the iOS URL scheme the
# Google sheet returns to from it.
# @public @type=string(minLength=1)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sentry DSN for app crashes and errors. Unset: Sentry stays off.
# @public @optional @type=url
EXPO_PUBLIC_SENTRY_DSN=

# Build time only (EAS / local release builds): Sentry org and project slugs
# for uploading source maps and debug symbols. Never bundled.
# @optional
SENTRY_ORG=

# @optional
SENTRY_PROJECT=

# Build time only. Without it, source map and debug symbol upload is skipped.
# @optional
SENTRY_AUTH_TOKEN=

# Build time only: Google Maps SDK for Android API key (Google Cloud Console >
# Credentials, restricted to the app's package), for Gatherings' maps on
# Android. Unset: the build succeeds and Android maps stay blank. iOS uses
# Apple Maps and needs no key.
# @optional
GOOGLE_MAPS_ANDROID_API_KEY=

# Build variant, set per EAS build profile (eas.json): `production` builds
# com.alrisali.app, anything else com.alrisali.app.dev.
# @public @type=enum(development, production)
APP_VARIANT=development

# Expo project ID (expo.dev > project > ID), for EAS Build and Submit. Build
# time only.
# @optional @sensitive=false
EAS_PROJECT_ID=

# Client API key the app sends on over-the-air update checks: the server's
# HOT_UPDATER_CLIENT_API_KEY. Required for production builds; development
# builds load their JavaScript from Metro and never check for updates.
# @public @required=eq($APP_VARIANT, production)
EXPO_PUBLIC_HOT_UPDATER_API_KEY=

# `hot-updater deploy` only (never bundled): the Railway bucket the update
# bundles upload to, as the server's HOT_UPDATER_BUCKET* variables, and the
# server's HOT_UPDATER_ADMIN_TOKEN. See hot-updater.config.ts.
# @optional @sensitive=false
HOT_UPDATER_BUCKET=

# @optional @sensitive=false
HOT_UPDATER_BUCKET_ENDPOINT=

# @optional @sensitive=false
HOT_UPDATER_BUCKET_REGION=

# @optional
HOT_UPDATER_BUCKET_ACCESS_KEY_ID=

# @optional
HOT_UPDATER_BUCKET_SECRET_ACCESS_KEY=

# @optional
HOT_UPDATER_ADMIN_TOKEN=
