# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DATABASE_AUTH_TOKEN=

# Sentry DSN for server errors. Unset: errors are only logged.
# @optional @type=url
SENTRY_DSN=

# Google OAuth client IDs (comma-separated) whose ID tokens the native Google
# sheet may present: the web client ID the app passes as `webClientId`, plus
# the iOS and Android client IDs. From Google Cloud Console > Credentials.
# @type=string(minLength=1) @sensitive=false
GOOGLE_CLIENT_IDS=

# iOS bundle IDs (comma-separated) of the app builds: the audience of the ID
# tokens the native Apple sheet issues.
# @type=string(minLength=1) @sensitive=false
APPLE_BUNDLE_IDS=com.alrisali.app,com.alrisali.app.dev

# Believers' cloud databases (ADR-0001) on Turso Cloud, via the Platform API.
# Set all three, or none to use LOCAL_SYNC_SERVER_URL (not allowed in
# production). Organization slug, from `turso org list`.
# @optional @sensitive=false
TURSO_ORG=

# Platform API token: `turso auth api-tokens mint alrisali-server`.
# @optional
TURSO_API_TOKEN=

# The group every Believer's database is created in (`turso group list`).
# @optional @sensitive=false
TURSO_GROUP=

# Development only, used when TURSO_* are unset: a local
# `tursodb --sync-server` (`bun run db:sync-server`) standing in for Turso
# Cloud. Devices sync at this URL too, so use the machine's LAN address for a
# physical device or the Android emulator (http://10.0.2.2:8090).
# @optional @type=url @sensitive=false
LOCAL_SYNC_SERVER_URL=http://127.0.0.1:8090

# The shared content database (ADR-0001) Admins publish to and every device
# pulls a read-only replica of. Created on the same host as Believers'
# databases (Turso Cloud in TURSO_GROUP, or the local sync server).
# @type=string(minLength=1) @sensitive=false
CONTENT_DATABASE_NAME=content

# Over-the-air updates (Hot Updater). Required in production; in local
# development the update routes stay off until every HOT_UPDATER_* variable is
# set. The bucket is the Railway bucket holding the update bundles: on Railway,
# reference its variables (BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY). The CLI that deploys updates uses the same bucket.
# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET=

# @required=forEnv(production) @type=url @sensitive=false
HOT_UPDATER_BUCKET_ENDPOINT=

# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET_REGION=

# Not secret: every presigned download URL carries it (X-Amz-Credential), and
# varlock would block those responses as a leak if it were sensitive.
# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET_ACCESS_KEY_ID=

# @required=forEnv(production)
HOT_UPDATER_BUCKET_SECRET_ACCESS_KEY=

# Bearer token the `hot-updater` CLI sends to the admin routes. Generate with
# `openssl rand -hex 32`. Never put it in the app.
# @required=forEnv(production) @type=string(minLength=32)
HOT_UPDATER_ADMIN_TOKEN=

# Client API key the app sends on update checks (the app's
# EXPO_PUBLIC_HOT_UPDATER_API_KEY). Hot Updater requires 32 random bytes in
# base64url: `openssl rand -base64 32 | tr '+/' '-_' | tr -d =`. The deploy
# step registers it.
# @required=forEnv(production) @type=string(minLength=43, maxLength=43)
HOT_UPDATER_CLIENT_API_KEY=
# Quran Foundation Content API (recitation audio and the Verse of the Day),
# OAuth2 client credentials of a "Backend/server app" from
# https://dev-console.quran.foundation/projects. Required in production;
# unset elsewhere, recitation answers "unavailable".
# @required=forEnv(production) @sensitive=false
QF_CLIENT_ID=

# Shown once when the Developer Console creates the app.
# @required=forEnv(production)
QF_CLIENT_SECRET=

# Which Quran Foundation environment the credentials belong to. New apps start
# in prelive (Al-Fatihah and Al-Baqarah only); switch with production access.
# @type=enum(prelive, production) @sensitive=false
QF_ENV=prelive
