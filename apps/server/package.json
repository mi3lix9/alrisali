{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db-server/src/schema/auth.ts --yes",
    "ota:schema": "bun src/scripts/ota-schema.ts",
    "ota:prepare": "bun src/scripts/ota-prepare.ts",
    "files:prepare": "bun src/scripts/files-prepare.ts",
    "deploy:migrate": "bun run --cwd ../../packages/db-server db:migrate:deploy && bun run ota:prepare && bun run files:prepare",
    "admin:grant": "varlock run -- bun src/scripts/grant-admin.ts"
  },
  "dependencies": {
    "@alrisali/api": "workspace:*",
    "@alrisali/auth": "workspace:*",
    "@alrisali/db-content": "workspace:*",
    "@alrisali/db-server": "workspace:*",
    "@alrisali/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1066.0",
    "@aws-sdk/s3-request-presigner": "3.1066.0",
    "@hot-updater/aws": "1.0.7",
    "@hot-updater/plugin-core": "1.0.7",
    "@hot-updater/server": "1.0.7",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sentry/node": "^11.8.0",
    "@tursodatabase/api": "2.0.5",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.7",
    "libsql": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alrisali/config": "workspace:*",
    "@alrisali/db-user": "workspace:*",
    "@alrisali/domain": "workspace:*",
    "@types/bun": "catalog:",
    "temporal-polyfill": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
